generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  /// One of the roles in src/platform/auth/permissions.ts (SQLite has no enums).
  role      String
  createdAt DateTime @default(now())
}

/// Append-only. UPDATE and DELETE are blocked by DB triggers (see init migration)
/// and by the Prisma client extension in src/platform/db.ts.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  app        String
  action     String
  entityType String
  entityId   String?
  before     String?
  after      String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([app])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// KYC Review Queue (src/apps/kyc). Enum-like columns are validated in src/apps/kyc/domain.ts.
/// User references (claimedBy, recommendedBy, decidedBy) hold User ids.
model KycCase {
  id                   String   @id
  customerName         String
  /// individual | business
  customerType         String
  /// ISO 3166-1 alpha-2
  country              String
  /// 0-100
  riskScore            Int
  /// LOW | MEDIUM | HIGH
  riskTier             String
  /// PII. Never rendered raw: maskPII() in queries, revealTaxId() for audited reveal.
  taxId                String
  /// JSON array of { type, fileName, status }
  documents            String
  /// NEW | IN_REVIEW | PENDING_APPROVAL | APPROVED | REJECTED | ESCALATED
  status               String   @default("NEW")
  claimedBy            String?
  recommendedBy        String?
  /// APPROVE | REJECT
  recommendation       String?
  recommendationReason String?
  escalationNote       String?
  decidedBy            String?
  decisionReason       String?
  createdAt            DateTime @default(now())
  slaDueAt             DateTime
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([riskTier])
  @@index([slaDueAt])
}
